local aimDistPart, aimDistAttach, aimDistBeams = nil, nil, nil

local function EnsureDistRing(seg)
    seg = seg or 48
    if aimDistPart and aimDistAttach and aimDistBeams and #aimDistAttach == seg then return end
    pcall(function() if aimDistPart then aimDistPart:Destroy() end end)
    aimDistPart = Instance.new("Part")
    aimDistPart.Anchored=true; aimDistPart.CanCollide=false
    aimDistPart.Transparency=1; aimDistPart.Size=Vector3.new(1,1,1)
    aimDistPart.Parent=workspace
    aimDistAttach = {}; aimDistBeams = {}
    for i=1,seg do
        local a=Instance.new("Attachment"); a.Parent=aimDistPart
        aimDistAttach[i]=a
    end
    for i=1,seg do
        local b=Instance.new("Beam")
        b.Attachment0=aimDistAttach[i]; b.Attachment1=aimDistAttach[(i%seg)+1]
        b.FaceCamera=true; b.LightEmission=1; b.LightInfluence=0
        b.Width0=0.15; b.Width1=0.15
        b.Transparency=NumberSequence.new(0.35)
        b.Color=ColorSequence.new(Color3.fromRGB(60,180,90))
        b.Enabled=false; b.Parent=aimDistPart
        aimDistBeams[i]=b
    end
end

