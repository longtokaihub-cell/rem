        else
            local part=Aim.Locked.Character:FindFirstChild(Aim.Settings.LockPart)
            if not part then AimCancelLock(); return end
            checkPos=part.Position
            local root=Aim.Locked.Character:FindFirstChild("HumanoidRootPart")
            local pred=AimPredict(Aim.Locked.Character,Aim.Settings.Prediction)
            if root and pred then checkPos=pred+(checkPos-root.Position) end
