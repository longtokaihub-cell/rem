-- ─── HIGHLIGHT UTILS ──────────────────────────────────────────────────────────

local function AddHighlight(obj, color, transparency)
    if not obj or not obj.Parent then return end
    pcall(function()
        local existing = obj:FindFirstChild("TokaiHighlight")
        if existing then existing:Destroy() end
        local h = Instance.new("Highlight")
        h.Name = "TokaiHighlight"
        h.FillColor = color
        h.OutlineColor = color
        h.FillTransparency = transparency or 0.3
        h.OutlineTransparency = 0
        h.Parent = obj
        highlightObjects[obj] = true
    end)
end

local function RemoveHighlight(obj)
    pcall(function()
        local h = obj:FindFirstChild("TokaiHighlight")
        if h then h:Destroy() end
        highlightObjects[obj] = nil
    end)
end

-- ─── HITBOX EXPANDER — EVENT-DRIVEN ───────────────────────────────────────────

local function restoreHitbox(part)
    local original = expandedHitboxes[part]
    if original and part and part.Parent then
        pcall(function()
            part.Size = original.size
            part.Transparency = original.transparency
        end)
    end
    expandedHitboxes[part] = nil
end

local function expandHitbox(part)
    if not part or not part:IsA("BasePart") then return end
    if part.Name ~= "Head" then return end
    if not config.hitboxExpander then return end
    local model = part.Parent
    if not model or not model:FindFirstChildWhichIsA("Humanoid") then return end
    if Players:GetPlayerFromCharacter(model) ~= nil then return end
    pcall(function()
        if not expandedHitboxes[part] then
            expandedHitboxes[part] = { size = part.Size, transparency = part.Transparency }
        end
        part.Size = Vector3.new(config.hitboxSize, config.hitboxSize, config.hitboxSize)
        part.CanCollide = false
        part.Transparency = 0.7
    end)
end

local function cleanupNPC(npcModel)
    local tracked = trackedNPCs[npcModel]
    if not tracked then return end
    for _, conn in ipairs(tracked.connections) do
        pcall(function() conn:Disconnect() end)
    end
    for _, part in ipairs(tracked.parts) do
        restoreHitbox(part)
    end
    RemoveHighlight(npcModel)
    trackedNPCs[npcModel] = nil
end

local function trackNPC(npcModel)
    if trackedNPCs[npcModel] then return end
    local humanoid = npcModel:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then return end
    local connections = {}
    local parts = {}
    local head = npcModel:FindFirstChild("Head")
    if head then
        expandHitbox(head)
        table.insert(parts, head)
    end
    local descConn = npcModel.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") and desc.Name == "Head" then
            task.wait(0.05)
            expandHitbox(desc)
            table.insert(parts, desc)
        end
    end)
    table.insert(connections, descConn)
    local diedConn = humanoid.Died:Connect(function()
        task.wait(0.1)
        cleanupNPC(npcModel)
    end)
    table.insert(connections, diedConn)
    local removingConn = npcModel.AncestryChanged:Connect(function(_, parent)
        if not parent then cleanupNPC(npcModel) end
    end)
    table.insert(connections, removingConn)
    trackedNPCs[npcModel] = { connections = connections, parts = parts }
end

local function untrackAllNPCs()
    for npcModel in pairs(trackedNPCs) do
        cleanupNPC(npcModel)
    end
    trackedNPCs = {}
    expandedHitboxes = {}
end

local function initHitboxExpander()
    local enemyContainer = workspace.Game
        and workspace.Game.Current
        and workspace.Game.Current.Spawned
        and workspace.Game.Current.Spawned.NPCs
        and workspace.Game.Current.Spawned.NPCs:FindFirstChild("enemies")
    if not enemyContainer then return end
    for _, npc in ipairs(enemyContainer:GetChildren()) do
        if npc:IsA("Model") then trackNPC(npc) end
    end
    enemyContainer.ChildAdded:Connect(function(child)
        if config.hitboxExpander and child:IsA("Model") then
            task.wait(0.1)
            trackNPC(child)
        end
    end)
end

task.spawn(function()
    while true do
        local enemies = workspace.Game
            and workspace.Game.Current
            and workspace.Game.Current.Spawned
            and workspace.Game.Current.Spawned.NPCs
            and workspace.Game.Current.Spawned.NPCs:FindFirstChild("enemies")
        if enemies then
            initHitboxExpander()
            enemies.AncestryChanged:Wait()
            untrackAllNPCs()
        end
        task.wait(1)
    end
end)

-- ─── GUN MOD SYSTEM ───────────────────────────────────────────────────────────

local function getEquippedWeaponParts()
    local char = lp.Character
    if not char then return {} end
    local parts = {}
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
                    table.insert(parts, desc)
                end
            end
        end
    end
    return parts
end

local function applyGunMods()
    if not config.gunModEnabled then return end
    local parts = getEquippedWeaponParts()
    for _, part in ipairs(parts) do
        if not gunModdedParts[part] then
            gunModdedParts[part] = {
                originalColor = part.Color,
                originalTransparency = part.Transparency,
            }
        end
        pcall(function()
            part.Transparency = config.gunTransparency
            if config.rainbowGun then
                part.Color = Color3.fromHSV(rainbowHue, 1, 1)
            elseif config.twoColorGun then
                -- alternate color per part index (odd/even by memory address hash)
                local idx = (tonumber(tostring(part):match("%d+")) or 0) % 2
                part.Color = idx == 0 and config.gunColor or config.gunColor2
            else
                part.Color = config.gunColor
            end
        end)
    end
end

local function restoreGunMods()
    for part, original in pairs(gunModdedParts) do
        if part and part.Parent then
            pcall(function()
                part.Color = original.originalColor
                part.Transparency = original.originalTransparency
            end)
        end
    end
    gunModdedParts = {}
end

-- ─── NO RECOIL ────────────────────────────────────────────────────────────────
-- Zeros the camera_recoil offset CFrame every frame so the viewmodel recoil
-- signal is overwritten before the lerp step reads it.

local function applyNoRecoil()
    if not config.noRecoil then return end
    local char = lp.Character
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            local offsets = child:FindFirstChild("Offsets")
            if offsets then
                local recoilOffset = offsets:FindFirstChild("camera_recoil")
                if recoilOffset and recoilOffset:IsA("CFrameValue") then
                    pcall(function()
                        recoilOffset.Value = CFrame.identity
                    end)
                end
            end
        end
    end
end

-- ─── SILENT AIM ───────────────────────────────────────────────────────────────

local function getEnemyContainer()
    return workspace.Game
        and workspace.Game.Current
        and workspace.Game.Current.Spawned
        and workspace.Game.Current.Spawned.NPCs
        and workspace.Game.Current.Spawned.NPCs:FindFirstChild("enemies")
end

local function getClosestHead()
    local container = getEnemyContainer()
    if not container then return nil end
    local referencePos
    if isMobile then
        local vp = camera.ViewportSize
        referencePos = Vector2.new(vp.X / 2, vp.Y / 2)
    else
        referencePos = UserInputService:GetMouseLocation()
    end
    local bestHeadPos, bestDist = nil, math.huge
    for _, enemy in ipairs(container:GetChildren()) do
        local head = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart")
        if head then
            local screenPoint, onScreen = camera:WorldToScreenPoint(head.Position)
            if onScreen then
                local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - referencePos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestHeadPos = head.Position
                end
            end
        end
    end
    return bestHeadPos
end

RunService.Heartbeat:Connect(function()
    if config.raycasting and target.enabled then
        target.position = getClosestHead()
    else
        target.position = nil
    end
end)

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if config.raycasting and target.position and method:lower() == "raycast" and self == Workspace then
        local args = { ... }
        if #args >= 2 and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
            local raycastParams = args[3]
            if raycastParams and raycastParams.CollisionGroup == "raycast_npc_neutral" then
                local origin = args[1]
                local dir = target.position - origin
                if dir.Magnitude > 0.001 then
                    args[2] = dir.Unit * args[2].Magnitude
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end
    return oldNamecall(self, ...)
end))

-- ─── AUTO HIT ────────────────────────────────────────────────────────────────

local function findRegisterHitEvent()
    local char = lp.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        local se = child:FindFirstChild("ServerEvents")
        if se then
            local re = se:FindFirstChild("RegisterHit")
            if re and re:IsA("RemoteEvent") then return re end
        end
    end
    return nil
end

local function getTargets()
    local results = {}
    local container = getEnemyContainer()
    if container then
        for _, npc in ipairs(container:GetChildren()) do
            if npc:IsA("Model") and npc:FindFirstChildWhichIsA("Humanoid") then
                local part = npc:FindFirstChild("Torso") or npc:FindFirstChild("HumanoidRootPart")
                if part then
                    table.insert(results, { model = npc, part = part })
                end
            end
        end
    end
    return results
end

task.spawn(function()
    while task.wait(0.2) do
        if config.autoHit then
            local hitEvent = findRegisterHitEvent()
            if hitEvent then
                local targets = getTargets()
                if #targets > 0 then
                    local payload = {}
                    for _, t in ipairs(targets) do
                        table.insert(payload, { amount = 1, target = t.model, is_friendly = false, part = t.part })
                    end
                    hitEvent:FireServer(payload, {})
                end
            end
        end
    end
end)

-- ─── INFINITE AMMO, STAMINA, FAST RELOAD ─────────────────────────────────────

local function findReloadEvent()
    local char = lp.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        local se = child:FindFirstChild("ServerEvents")
        if se then
            local re = se:FindFirstChild("ReloadAmmo")
            if re and re:IsA("RemoteEvent") then return re end
        end
    end
    return nil
end

task.spawn(function()
    while task.wait(0.1) do
        local Character = lp.Character
        if Character then
            -- stamina
            local Humanoid = Character:FindFirstChild("Humanoid")
            if Humanoid then
                local Values = Humanoid:FindFirstChild("Values")
                if Values then
                    local Stamina = Values:FindFirstChild("Stamina")
                    if Stamina and Stamina:IsA("NumberValue") then
                        if config.infiniteStamina then
                            originalStaminaValue = originalStaminaValue or Stamina.Value
                            Stamina.Value = 99999
                        elseif originalStaminaValue and Stamina.Value == 99999 then
                            Stamina.Value = originalStaminaValue
                            originalStaminaValue = nil
                        end
                    end
                end
            end

            -- ammo + fast reload from WeaponData/Essentials
            local items = {}
            for _, v in ipairs(Character:GetChildren()) do table.insert(items, v) end
            local Backpack = lp:FindFirstChild("Backpack")
            if Backpack then
                for _, v in ipairs(Backpack:GetChildren()) do table.insert(items, v) end
            end

            for _, item in ipairs(items) do
                if item:IsA("Tool") then
                    local WeaponData = item:FindFirstChild("WeaponData")
                    if WeaponData then
                        local Essentials = WeaponData:FindFirstChild("Essentials")
                        if Essentials then
                            -- infinite ammo
                            local Ammo = Essentials:FindFirstChild("Ammo")
                            if Ammo and Ammo:IsA("NumberValue") then
                                if config.infiniteAmmo then
                                    if originalAmmoValues[item] == nil then
                                        originalAmmoValues[item] = Ammo.Value
                                    end
                                    Ammo.Value = 9999
                                elseif originalAmmoValues[item] ~= nil then
                                    if Ammo.Value == 9999 then
                                        Ammo.Value = originalAmmoValues[item]
                                    end
                                    originalAmmoValues[item] = nil
                                end
                            end

                            -- fast reload — patch ReloadSpeed multiplier value
                            -- higher = faster; default is 1.0
                            local ReloadSpeed = Essentials:FindFirstChild("ReloadSpeed")
                                or Essentials:FindFirstChild("reload_speed_multiplier")
                            if ReloadSpeed and ReloadSpeed:IsA("NumberValue") then
                                if config.fastReload then
                                    if originalReloadValues[item] == nil then
                                        originalReloadValues[item] = ReloadSpeed.Value
                                    end
                                    ReloadSpeed.Value = config.fastReloadSpeed
                                elseif originalReloadValues[item] ~= nil then
                                    ReloadSpeed.Value = originalReloadValues[item]
                                    originalReloadValues[item] = nil
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- auto reload
task.spawn(function()
    while task.wait(config.autoReloadInterval) do
        if config.autoReload then
            pcall(function()
                local re = findReloadEvent()
                if re then re:FireServer(false) end
            end)
        end
    end
end)

-- ─── OBJECTIVE & PICKUP ESP ───────────────────────────────────────────────────

local PICKUP_CONFIG = {
    mission_              = { key = "objectiveESP",  color = Color3.fromRGB(0, 255, 0),   prefix = true  },
    scenery_phone_ringing = { key = "objectiveESP",  color = Color3.fromRGB(255, 255, 255), prefix = false },
    pickup_ammo           = { key = "ammoESP",       color = Color3.fromRGB(255, 255, 0)   },
    pickup_armor          = { key = "armorESP",      color = Color3.fromRGB(0, 0, 255)     },
    pickup_medkit         = { key = "medkitESP",     color = Color3.fromRGB(255, 0, 0)     },
    pickup_gear           = { key = "gearESP",       color = Color3.fromRGB(255, 165, 0)   },
    pickup_throwable      = { key = "throwableESP",  color = Color3.fromRGB(180, 0, 255)   },
}

local function resolvePickupConfig(name)
    for key, cfg in pairs(PICKUP_CONFIG) do
        if cfg.prefix and name:sub(1, #key) == key then return cfg end
    end
    return PICKUP_CONFIG[name]
end

local function trackPickup(obj)
    if trackedPickups[obj] then return end
    local conn = obj.AncestryChanged:Connect(function(_, parent)
        if not parent then
            RemoveHighlight(obj)
            if trackedPickups[obj] then
                pcall(function() trackedPickups[obj]:Disconnect() end)
                trackedPickups[obj] = nil
            end
        end
    end)
    trackedPickups[obj] = conn
end

local function UpdateObjectiveESP()
    for obj in pairs(highlightObjects) do
        if obj and obj.Parent then
            local cfg = resolvePickupConfig(obj.Name)
            if cfg and not config[cfg.key] then
                RemoveHighlight(obj)
            end
        end
    end
    local gameObjects = workspace.Game
        and workspace.Game.Current
        and workspace.Game.Current.Spawned
        and workspace.Game.Current.Spawned.GameObjects
    if not gameObjects then return end
    for _, obj in ipairs(gameObjects:GetChildren()) do
        local cfg = resolvePickupConfig(obj.Name)
        if cfg and config[cfg.key] and not obj:FindFirstChild("TokaiHighlight") then
            AddHighlight(obj, cfg.color, 0.3)
            trackPickup(obj)
        end
    end
end

-- ─── ENTITY ESP ───────────────────────────────────────────────────────────────

local function UpdateESP()
    for obj in pairs(highlightObjects) do
        if obj and obj.Parent and obj:FindFirstChildWhichIsA("Humanoid") then
            local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
            if isPlayer and not config.playerESP then
                RemoveHighlight(obj)
            elseif not isPlayer and not config.zombieESP then
                RemoveHighlight(obj)
            end
        end
    end
    if config.playerESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") then
                if not player.Character:FindFirstChild("TokaiHighlight") then
                    AddHighlight(player.Character, Color3.fromRGB(0, 255, 255), 0.3)
                end
            end
        end
    end
    if config.zombieESP then
        local enemyContainer = getEnemyContainer()
        if enemyContainer then
            for _, zombie in ipairs(enemyContainer:GetChildren()) do
                if zombie:IsA("Model") and zombie:FindFirstChildWhichIsA("Humanoid") then
                    if not zombie:FindFirstChild("TokaiHighlight") then
                        AddHighlight(zombie, Color3.fromRGB(255, 0, 0), 0.3)
                    end
                end
            end
        end
    end
end

-- ─── ENVIRONMENT + GUN MOD HEARTBEAT ─────────────────────────────────────────

RunService.Heartbeat:Connect(function(dt)
    -- environment
    if config.nofog then Lighting.FogEnd = 100000 else Lighting.FogEnd = originalFogEnd end
    if config.fullbright then
        Lighting.Brightness = 3
        Lighting.GlobalShadows = false
    else
        Lighting.Brightness = originalBrightness
        Lighting.GlobalShadows = true
    end

    -- rainbow hue advance
    if config.rainbowGun then
        rainbowHue = (rainbowHue + dt * config.rainbowSpeed * 0.3) % 1
    end

    -- gun mods
    if config.gunModEnabled then
        applyGunMods()
    end

    -- no recoil
    applyNoRecoil()

    -- ESP
    UpdateObjectiveESP()
    UpdateESP()
end)

