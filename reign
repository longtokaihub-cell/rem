local PICKUP_CONFIG = {
    mission_              = {key="objectiveESP", color=Color3.fromRGB(0,255,0),   prefix=true},
    scenery_phone_ringing = {key="objectiveESP", color=Color3.fromRGB(255,255,255)},
    pickup_ammo           = {key="ammoESP",      color=Color3.fromRGB(255,255,0)},
    pickup_armor          = {key="armorESP",     color=Color3.fromRGB(0,0,255)},
    pickup_medkit         = {key="medkitESP",    color=Color3.fromRGB(255,0,0)},
    pickup_gear           = {key="gearESP",      color=Color3.fromRGB(255,165,0)},
    pickup_throwable      = {key="throwableESP", color=Color3.fromRGB(180,0,255)},
}

local function resolvePickup(name)
    for k, cfg in pairs(PICKUP_CONFIG) do
        if cfg.prefix and name:sub(1, #k) == k then return cfg end
    end
    return PICKUP_CONFIG[name]
end

local function trackPickup(obj)
    if trackedPickups[obj] then return end
    trackedPickups[obj] = obj.AncestryChanged:Connect(function(_, parent)
        if not parent then
            RemoveHighlight(obj)
            if trackedPickups[obj] then pcall(function() trackedPickups[obj]:Disconnect() end) end
            trackedPickups[obj] = nil
        end
    end)
end

local function UpdatePickupESP()
    for obj in pairs(highlightObjects) do
        if obj and obj.Parent then
            local cfg = resolvePickup(obj.Name)
            if cfg and not Config[cfg.key] then RemoveHighlight(obj) end
            -- collectible toggle off
            if not Config.collectibleESP and obj:FindFirstChild("ObjectConfig") then
                RemoveHighlight(obj)
            end
        end
    end
    local gameObjects = workspace.Game and workspace.Game.Current
        and workspace.Game.Current.Spawned and workspace.Game.Current.Spawned.GameObjects
    if not gameObjects then return end

    -- standard pickups (pickup_ammo, pickup_medkit, etc.)
    for _, obj in ipairs(gameObjects:GetChildren()) do
        local cfg = resolvePickup(obj.Name)
        if cfg and Config[cfg.key] and not obj:FindFirstChild("TokaiHL") then
            AddHighlight(obj, cfg.color, 0.3); trackPickup(obj)
        end
    end

    -- collectible ESP — nằm trong subfolder "collectible", mỗi child là một collectible_pickup
    -- display_name StringValue nằm trong ObjectConfig folder của mỗi object
    if Config.collectibleESP then
        local collectibleFolder = gameObjects:FindFirstChild("collectible")
        if collectibleFolder then
            for _, obj in ipairs(collectibleFolder:GetChildren()) do
                if obj:IsA("Model") and not obj:FindFirstChild("TokaiHL") then
                    -- lấy tên hiển thị từ ObjectConfig.display_name nếu có
                    local displayName = "Collectible"
                    local objCfg = obj:FindFirstChild("ObjectConfig")
                    if objCfg then
                        local dn = objCfg:FindFirstChild("display_name")
                        if dn and dn.Value ~= "" then displayName = dn.Value end
                    end
                    AddHighlight(obj, Color3.fromRGB(255, 215, 0), 0.3)
                    trackPickup(obj)
                end
            end
        end
    end
end

