local function getEnemyContainer()
    return workspace.Game
        and workspace.Game.Current
        and workspace.Game.Current.Spawned
        and workspace.Game.Current.Spawned.NPCs
        and workspace.Game.Current.Spawned.NPCs:FindFirstChild("enemies")
end

local function initHitboxExpander()
    local container = getEnemyContainer()
    if not container then return end
    for _, npc in ipairs(container:GetChildren()) do
        if npc:IsA("Model") then trackNPC(npc) end
    end
    container.ChildAdded:Connect(function(child)
        if Config.hitboxExpander and child:IsA("Model") then
            task.wait(0.1); trackNPC(child)
        end
    end)
end

task.spawn(function()
    while true do
        local container = getEnemyContainer()
        if container then
            initHitboxExpander()
            container.AncestryChanged:Wait()
            untrackAllNPCs()
        end
        task.wait(1)
    end
end)

