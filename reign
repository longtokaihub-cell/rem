-- ─── SPEED HACK ───────────────────────────────────────────────────────────────
-- MovementSpeed.lua reads default_walk_speed from MiscValues every RenderStepped.
-- Writing to that NumberValue directly feeds into the game's own refresh() pipeline
-- so sprint multipliers, crouch penalties, etc. all still apply on top of our base.

local originalWalkSpeed = nil

task.spawn(function()
    while task.wait(0.1) do
        local Character = lp.Character
        if not Character then continue end
        local Humanoid = Character:FindFirstChild("Humanoid")
        if not Humanoid then continue end
        local Values = Humanoid:FindFirstChild("Values")
        if not Values then continue end
        local MiscValues = Values:FindFirstChild("MiscValues")
        if not MiscValues then continue end
        local DefaultWalkSpeed = MiscValues:FindFirstChild("DefaultWalkSpeed")
        if not DefaultWalkSpeed then continue end

        if config.speedHack then
            if not originalWalkSpeed then originalWalkSpeed = DefaultWalkSpeed.Value end
            DefaultWalkSpeed.Value = config.speedHackValue
        else
            if originalWalkSpeed ~= nil then
                DefaultWalkSpeed.Value = originalWalkSpeed
                originalWalkSpeed = nil
            end
        end
    end
end)

-- ─── AUTO RELOAD ──────────────────────────────────────────────────────────────

local function findReloadEvent()
    local char = lp.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        local se = child:FindFirstChild("ServerEvents")
        if se then
            local re = se:FindFirstChild("ReloadAmmo")
            if re and re:IsA("RemoteEvent") then return re end
        end
    end
    return nil
end

task.spawn(function()
    while task.wait(config.autoReloadInterval) do
        if config.autoReload then
            pcall(function()
                local re = findReloadEvent()
                if re then re:FireServer(false) end
            end)
        end
    end
end)

-- ─── GUN MOD ─────────────────────────────────────────────────────────────────
--
-- Weapon model lives at Character[Tool] → Equipped folder → BaseParts.
-- We iterate all tools in Character + Backpack, find their Equipped child,
-- and apply visual overrides directly on the BaseParts.
-- Originals are saved on first touch and restored on toggle-off or unload.

local function getWeaponParts()
    local parts = {}
    local char = lp.Character
    if not char then return parts end
    local sources = {char}
    local backpack = lp:FindFirstChild("Backpack")
    if backpack then table.insert(sources, backpack) end
    for _, src in ipairs(sources) do
        for _, item in ipairs(src:GetChildren()) do
            if item:IsA("Tool") then
                local equipped = item:FindFirstChild("Equipped")
                if equipped then
                    for _, part in ipairs(equipped:GetDescendants()) do
                        if part:IsA("BasePart") then
                            table.insert(parts, part)
                        end
                    end
                end
            end
        end
    end
    return parts
end

local function saveGunOriginal(part)
    if not gunModOriginals[part] then
        gunModOriginals[part] = {
            transparency = part.Transparency,
            color        = part.Color,
        }
    end
end

local function restoreAllGunParts()
    for part, orig in pairs(gunModOriginals) do
        if part and part.Parent then
            pcall(function()
                part.Transparency = orig.transparency
                part.Color        = orig.color
            end)
        end
    end
    gunModOriginals = {}
end

local function updateGunMods(dt)
    local anyActive = config.gunTransparency or config.gunColor or config.gunRainbow
    if not anyActive then
        if next(gunModOriginals) then restoreAllGunParts() end
        return
    end

    -- rainbow hue advances at 60°/s — full cycle every 6 seconds
    if config.gunRainbow then
        rainbowHue = (rainbowHue + dt * 60) % 360
    end

    local parts = getWeaponParts()
    for _, part in ipairs(parts) do
        saveGunOriginal(part)
        pcall(function()
            if config.gunTransparency then
                part.Transparency = config.gunTranspValue
            else
                part.Transparency = gunModOriginals[part] and gunModOriginals[part].transparency or 0
            end

            if config.gunRainbow then
                part.Color = Color3.fromHSV(rainbowHue / 360, 1, 1)
            elseif config.gunColor then
                part.Color = config.gunColorValue
            else
                part.Color = gunModOriginals[part] and gunModOriginals[part].color or part.Color
            end
        end)
    end
end

