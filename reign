-- ─── NO RECOIL ────────────────────────────────────────────────────────────────
--
-- ConnectCameraRecoil  → ghi CFrame.Angles vào offsets_folder["camera_recoil"]
-- ConnectVisualRecoil  → shove spring vào offsets_folder["visual_recoil"]
-- Hook __newindex, intercept Value write trên hai CFrameValue đó → CFrame.new()
-- VisualRecoilBlur.NearIntensity → zero.

local ZERO_CFRAME = CFrame.new()
local recoilHook

local function installRecoilHook()
    if recoilHook then return end
    recoilHook = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
        if config.noRecoil then
            if key == "Value"
            and typeof(value) == "CFrame"
            and self:IsA("CFrameValue")
            and (self.Name == "camera_recoil" or self.Name == "visual_recoil") then
                return recoilHook(self, key, ZERO_CFRAME)
            end
            if key == "NearIntensity" and self:IsA("BlurEffect") and self.Name == "VisualRecoilBlur" then
                return recoilHook(self, key, 0)
            end
        end
        return recoilHook(self, key, value)
    end))
end

installRecoilHook()

-- ─── HIGHLIGHT UTILS ──────────────────────────────────────────────────────────

local function AddHighlight(obj, color, transparency)
    if not obj or not obj.Parent then return end
    pcall(function()
        local existing = obj:FindFirstChild("TokaiHighlight")
        if existing then existing:Destroy() end
        local h = Instance.new("Highlight")
        h.Name = "TokaiHighlight"
        h.FillColor = color
        h.OutlineColor = color
        h.FillTransparency = transparency or 0.3
        h.OutlineTransparency = 0
        h.Parent = obj
        highlightObjects[obj] = true
    end)
end

local function RemoveHighlight(obj)
    pcall(function()
        local h = obj:FindFirstChild("TokaiHighlight")
        if h then h:Destroy() end
        highlightObjects[obj] = nil
    end)
end

-- ─── HITBOX EXPANDER — EVENT-DRIVEN ───────────────────────────────────────────

local function restoreHitbox(part)
    local original = expandedHitboxes[part]
    if original and part and part.Parent then
        pcall(function()
            part.Size = original.size
            part.Transparency = original.transparency
        end)
    end
    expandedHitboxes[part] = nil
end

local function expandHitbox(part)
    if not part or not part:IsA("BasePart") then return end
    if part.Name ~= "Head" then return end
    if not config.hitboxExpander then return end
    local model = part.Parent
    if not model or not model:FindFirstChildWhichIsA("Humanoid") then return end
    if Players:GetPlayerFromCharacter(model) ~= nil then return end
    pcall(function()
        if not expandedHitboxes[part] then
            expandedHitboxes[part] = {
                size = part.Size,
                transparency = part.Transparency
            }
        end
        part.Size = Vector3.new(config.hitboxSize, config.hitboxSize, config.hitboxSize)
        part.CanCollide = false
        part.Transparency = 0.7
    end)
end

local function cleanupNPC(npcModel)
    local tracked = trackedNPCs[npcModel]
    if not tracked then return end
    for _, conn in ipairs(tracked.connections) do
        pcall(function() conn:Disconnect() end)
    end
    for _, part in ipairs(tracked.parts) do
        restoreHitbox(part)
    end
    RemoveHighlight(npcModel)
    trackedNPCs[npcModel] = nil
end

local function trackNPC(npcModel)
    if trackedNPCs[npcModel] then return end
    local humanoid = npcModel:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then return end

    local connections = {}
    local parts = {}

    local head = npcModel:FindFirstChild("Head")
    if head then
        expandHitbox(head)
        table.insert(parts, head)
    end

    local descConn = npcModel.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") and desc.Name == "Head" then
            task.wait(0.05)
            expandHitbox(desc)
            table.insert(parts, desc)
        end
    end)
    table.insert(connections, descConn)

    local diedConn = humanoid.Died:Connect(function()
        task.wait(0.1)
        cleanupNPC(npcModel)
    end)
    table.insert(connections, diedConn)

    local removingConn = npcModel.AncestryChanged:Connect(function(_, parent)
        if not parent then
            cleanupNPC(npcModel)
        end
    end)
    table.insert(connections, removingConn)

    trackedNPCs[npcModel] = {connections = connections, parts = parts}
end

local function untrackAllNPCs()
    for npcModel, _ in pairs(trackedNPCs) do
        cleanupNPC(npcModel)
    end
    trackedNPCs = {}
    expandedHitboxes = {}
end

local function initHitboxExpander()
    local enemyContainer = workspace.Game
        and workspace.Game.Current
        and workspace.Game.Current.Spawned
        and workspace.Game.Current.Spawned.NPCs
        and workspace.Game.Current.Spawned.NPCs:FindFirstChild("enemies")
    if not enemyContainer then return end

    for _, npc in ipairs(enemyContainer:GetChildren()) do
        if npc:IsA("Model") then trackNPC(npc) end
    end

    enemyContainer.ChildAdded:Connect(function(child)
        if config.hitboxExpander and child:IsA("Model") then
            task.wait(0.1)
            trackNPC(child)
        end
    end)
end

local function watchForGameReady()
    task.spawn(function()
        while true do
            local enemies = workspace.Game
                and workspace.Game.Current
                and workspace.Game.Current.Spawned
                and workspace.Game.Current.Spawned.NPCs
                and workspace.Game.Current.Spawned.NPCs:FindFirstChild("enemies")
            if enemies then
                initHitboxExpander()
                enemies.AncestryChanged:Wait()
                untrackAllNPCs()
            end
            task.wait(1)
        end
    end)
end

