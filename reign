    Text = 'Auto Reload Interval (s)',
    Default = 2, Min = 0.5, Max = 10, Rounding = 1, Compact = false,
    Callback = function(v) config.autoReloadInterval = v end
})

UtilityRight:AddToggle('FastReload', { Text = 'Fast Reload', Default = false })
Toggles.FastReload:OnChanged(function()
    config.fastReload = Toggles.FastReload.Value
    if not config.fastReload then
        -- restore all reload speeds on disable
        local char = lp.Character
        local Backpack = lp:FindFirstChild("Backpack")
        local items = {}
        if char then for _, v in ipairs(char:GetChildren()) do table.insert(items, v) end end
        if Backpack then for _, v in ipairs(Backpack:GetChildren()) do table.insert(items, v) end end
        for _, item in ipairs(items) do
            if item:IsA("Tool") and originalReloadValues[item] ~= nil then
                local WD = item:FindFirstChild("WeaponData")
                if WD then
                    local E = WD:FindFirstChild("Essentials")
                    if E then
                        local RS = E:FindFirstChild("ReloadSpeed") or E:FindFirstChild("reload_speed_multiplier")
                        if RS then pcall(function() RS.Value = originalReloadValues[item] end) end
                    end
                end
                originalReloadValues[item] = nil
            end
        end
    end
end)

UtilityRight:AddSlider('FastReloadSpeed', {
    Text = 'Reload Speed Multiplier',
    Default = 5, Min = 1, Max = 20, Rounding = 1, Compact = false,
    Callback = function(v) config.fastReloadSpeed = v end
})

