Library:OnUnload(function()
    untrackAllNPCs()
    restoreGunMods()
    for obj, conn in pairs(trackedPickups) do
        pcall(function() conn:Disconnect() end)
        RemoveHighlight(obj)
    end
    trackedPickups = {}
    Library.Unloaded = true
end)
