                end
                if Aim.Settings.ThirdPerson then
                    local v=camera:WorldToViewportPoint(aimPos)
                    local ml=UserInputService:GetMouseLocation()
                    local s=math.clamp(Aim.Settings.ThirdPersonSens,0.1,5)
                    mousemoverel and mousemoverel((v.X-ml.X)*s,(v.Y-ml.Y)*s)
                else
                    if Aim.Settings.SmoothAim and Aim.Settings.Sensitivity==0 then
                        camera.CFrame=camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position,aimPos),0.15)
                    elseif Aim.Settings.Sensitivity>0 then
                        AimAnimation=TweenService:Create(camera,TweenInfo.new(Aim.Settings.Sensitivity,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{CFrame=CFrame.new(camera.CFrame.Position,aimPos)})
                        AimAnimation:Play()
                    else
                        camera.CFrame=CFrame.new(camera.CFrame.Position,aimPos)
                    end
                end
                Aim.FOVCircle.Color=Aim.FOV.LockedColor
            end
        else AimSetHighlight(nil) end
    else AimSetHighlight(nil) end

    -- Distance ring
    local root=AimGetLocalRoot()
    local visible=Aim.Settings.DistanceCircleVisible and type(Aim.Settings.MaxDistance)=="number" and Aim.Settings.MaxDistance>0
    if visible and root then
        EnsureDistRing(48)
        local hum=lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        local yOff=hum and -(hum.HipHeight+1) or -3
        aimDistPart.CFrame=CFrame.new(root.Position+Vector3.new(0,yOff,0))
        local r=Aim.Settings.MaxDistance; local seg=#aimDistAttach
        for i=1,seg do
            local t=(i/seg)*(math.pi*2)
            aimDistAttach[i].Position=Vector3.new(math.cos(t)*r,0,math.sin(t)*r)
        end
        for _,b in ipairs(aimDistBeams) do b.Enabled=true end
    else
        if aimDistBeams then for _,b in ipairs(aimDistBeams) do b.Enabled=false end end
    end
end)

AimConnections.InputBegan=UserInputService.InputBegan:Connect(function(input)
    if AimTyping then return end
    pcall(function()
        local k=Aim.Settings.TriggerKey
        local match=(k=="MouseButton2" and input.UserInputType==Enum.UserInputType.MouseButton2)
            or (k=="MouseButton1" and input.UserInputType==Enum.UserInputType.MouseButton1)
            or (k=="Q" and input.KeyCode==Enum.KeyCode.Q)
        if match then
            if Aim.Settings.Toggle then AimRunning=not AimRunning; if not AimRunning then AimCancelLock() end
            else AimRunning=true end
        end
        -- invisible keybind
        local ik=Aim.Settings.InvisibleKey
        local imatch=(ik=="MouseButton1" and input.UserInputType==Enum.UserInputType.MouseButton1)
            or (ik=="MouseButton2" and input.UserInputType==Enum.UserInputType.MouseButton2)
            or (input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode.Name==ik)
        if imatch then
            Aim.Settings.InvisibleEnabled=not Aim.Settings.InvisibleEnabled
            if Aim.Settings.InvisibleEnabled then startInvis() else stopInvis() end
        end
    end)
end)

AimConnections.InputEnded=UserInputService.InputEnded:Connect(function(input)
    if AimTyping or Aim.Settings.Toggle then return end
    pcall(function()
        local k=Aim.Settings.TriggerKey
        local match=(k=="MouseButton2" and input.UserInputType==Enum.UserInputType.MouseButton2)
            or (k=="MouseButton1" and input.UserInputType==Enum.UserInputType.MouseButton1)
            or (k=="Q" and input.KeyCode==Enum.KeyCode.Q)
        if match then AimRunning=false; AimCancelLock() end
    end)
end)

lp.CharacterAdded:Connect(function() AimCancelLock() end)

Aim.Exit = function()
    stopInvis()
    for _,c in next,AimConnections do pcall(function() c:Disconnect() end) end
    pcall(function() Aim.FOVCircle:Remove() end)
    pcall(function() if AimHighlight then AimHighlight:Destroy() end end)
    pcall(function() if aimDistPart then aimDistPart:Destroy() end end)
    getgenv().TokaiAimbot=nil
end

