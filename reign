Library:OnUnload(function()
    tracerFolder:Destroy()
    untrackAllNPCs()
    for obj, conn in pairs(trackedPickups) do
        pcall(function() conn:Disconnect() end)
        RemoveHighlight(obj)
    end
    trackedPickups = {}
    Library.Unloaded = true
end)
