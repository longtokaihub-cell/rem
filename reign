-- ─── UI (BRM5 pattern: WrapSection → callback inline) ────────────────────────

local function WrapSection(Groupbox)
    local S = {}
    function S:AddToggle(Data)
        local Flag = tostring(Data.Flag or Data.Name or "T")
        local t = Groupbox:AddToggle(Flag, {Text=tostring(Data.Name or Flag), Default=Data.Default or false})
        if Data.Callback then t:OnChanged(Data.Callback) end
        return t
    end
    function S:AddSlider(Data)
        local Flag = tostring(Data.Flag or Data.Name or "S")
        local s = Groupbox:AddSlider(Flag, {Text=tostring(Data.Name or Flag), Default=Data.Default or 0, Min=Data.Min or 0, Max=Data.Max or 100, Rounding=Data.Rounding or 0, Suffix=Data.Suffix, Compact=Data.Compact or false})
        if Data.Callback then s:OnChanged(Data.Callback) end
        return s
    end
    function S:AddDropdown(Data)
        local Flag = tostring(Data.Flag or Data.Name or "D")
        local d = Groupbox:AddDropdown(Flag, {Text=tostring(Data.Name or Flag), Values=Data.Values or {}, Default=Data.Default, Multi=false})
        if Data.Callback then d:OnChanged(Data.Callback) end
        return d
    end
    function S:AddColorPicker(Data)
        local Flag = tostring(Data.Flag or Data.Name or "C")
        local label = Groupbox:AddLabel(tostring(Data.Name or Flag))
        label:AddColorPicker(Flag, {Default=Data.Default or Color3.new(1,1,1)})
        if Data.Callback and Options[Flag] then Options[Flag]:OnChanged(Data.Callback) end
    end
    function S:AddButton(Data)
        return Groupbox:AddButton(Data.Name or "Button", Data.Callback or function() end)
    end
    return S
end

local function DrawSection(Tab, Name, Position)
    if string.lower(Position or "left") == "right" then
        return WrapSection(Tab:AddRightGroupbox(Name))
    end
    return WrapSection(Tab:AddLeftGroupbox(Name))
end

