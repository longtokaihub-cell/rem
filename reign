local function AimPredict(char, mul)
    if not Aim.Settings.PredictionEnabled then return nil end
    local root=char:FindFirstChild("HumanoidRootPart")
    if root and type(mul)=="number" and mul>0 then
        return root.Position + root.Velocity*mul
    end
    return nil
end

local function AimGetClosestPartPos(char)
    local mousePt=UserInputService:GetMouseLocation()
    local bestDist,bestPos=math.huge,nil
    local root=char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local predRoot=AimPredict(char,Aim.Settings.Prediction)
    for _,pn in ipairs(aimbotBodyParts) do
        local part=char:FindFirstChild(pn)
        if part then
            local pos=part.Position
            if predRoot then pos=predRoot+(pos-root.Position) end
            local v,on=camera:WorldToViewportPoint(pos)
            if on then
                local d=(Vector2.new(mousePt.X,mousePt.Y)-Vector2.new(v.X,v.Y)).Magnitude
                if d<bestDist then bestDist=d; bestPos=pos end
            end
        end
    end
    return bestPos or root.Position
end

local AimReqDist = 2000

local function AimGetClosestPlayer()
    if not Aim.Locked then
        AimReqDist = Aim.FOV.Enabled and Aim.FOV.Amount or 2000
        local localRoot=AimGetLocalRoot()
        local localPos=localRoot and localRoot.Position
        for _,v in next,Players:GetPlayers() do
            if v~=lp and not Aim.IgnoreList[v] then
                if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
                    if Aim.Settings.TeamCheck and v.Team==lp.Team then continue end
                    if Aim.Settings.AliveCheck and v.Character:FindFirstChildOfClass("Humanoid").Health<=0 then continue end
                    if localPos then
                        local tr=v.Character:FindFirstChild("HumanoidRootPart")
                        if tr and type(Aim.Settings.MaxDistance)=="number" and Aim.Settings.MaxDistance>0 then
                            if (tr.Position-localPos).Magnitude>Aim.Settings.MaxDistance then continue end
                        end
                    end
                    local aimPos
                    if Aim.Settings.LockPart=="DirectTouch" then
                        aimPos=AimGetClosestPartPos(v.Character); if not aimPos then continue end
                    else
                        if not v.Character:FindFirstChild(Aim.Settings.LockPart) then continue end
                        local part=v.Character[Aim.Settings.LockPart]
                        aimPos=part.Position
                        local root=v.Character:FindFirstChild("HumanoidRootPart")
                        local pred=AimPredict(v.Character,Aim.Settings.Prediction)
                        if root and pred then aimPos=pred+(aimPos-root.Position) end
                        if Aim.Settings.WallCheck and #camera:GetPartsObscuringTarget({aimPos},v.Character:GetDescendants())>0 then continue end
                    end
                    local vec,on=camera:WorldToViewportPoint(aimPos)
                    local ml=UserInputService:GetMouseLocation()
                    local d=(Vector2.new(ml.X,ml.Y)-Vector2.new(vec.X,vec.Y)).Magnitude
                    if d<AimReqDist and on then AimReqDist=d; Aim.Locked=v end
                end
            end
        end
    else
        if not Aim.Locked.Character or not Aim.Locked.Character:FindFirstChildOfClass("Humanoid") then AimCancelLock(); return end
        if Aim.Settings.AliveCheck and Aim.Locked.Character:FindFirstChildOfClass("Humanoid").Health<=0 then AimCancelLock(); return end
        if Aim.Settings.ForceConnect then return end
        local checkPos
        if Aim.Settings.LockPart=="DirectTouch" then
