    Callback = function(v) config.rainbowSpeed = v end
})

GunRight:AddToggle('TwoColorGun', { Text = 'Two Color Gun', Default = false })
Toggles.TwoColorGun:OnChanged(function()
    config.twoColorGun = Toggles.TwoColorGun.Value
    if config.twoColorGun then
        config.rainbowGun = false
        if Toggles.RainbowGun then
