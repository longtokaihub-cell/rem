-- ─── DRAWING ESP — Box, Health, Name, Distance ────────────────────────────────
-- Cơ chế mượn từ REBM5: Drawing.new("Square") cho box + health bar,
-- Drawing.new("Text") cho name/distance. Update mỗi Heartbeat.
-- WorldToViewportPoint → tính box height từ Head→HumanoidRootPart delta.

local drawingESPPool = {}  -- [model] = { Box, BoxOutline, HealthBar, HealthBarOutline, Name, Distance }

local function createDrawingSet()
    local d = {}
    d.BoxOutline       = Drawing.new("Square")
    d.BoxOutline.Filled = false; d.BoxOutline.Thickness = 3
    d.BoxOutline.Color  = Color3.new(0,0,0); d.BoxOutline.Transparency = 1
    d.BoxOutline.ZIndex = 1; d.BoxOutline.Visible = false

    d.Box              = Drawing.new("Square")
    d.Box.Filled       = false; d.Box.Thickness = 1
    d.Box.Transparency = 1; d.Box.ZIndex = 2; d.Box.Visible = false

    d.HealthBarOutline = Drawing.new("Square")
    d.HealthBarOutline.Filled = true; d.HealthBarOutline.Thickness = 1
    d.HealthBarOutline.Color  = Color3.new(0,0,0)
    d.HealthBarOutline.Transparency = 1; d.HealthBarOutline.ZIndex = 1; d.HealthBarOutline.Visible = false

    d.HealthBar        = Drawing.new("Square")
    d.HealthBar.Filled = true; d.HealthBar.Thickness = 1
    d.HealthBar.ZIndex = 2; d.HealthBar.Visible = false

    d.Name             = Drawing.new("Text")
    d.Name.Size        = 13; d.Name.Center = true
    d.Name.Outline     = true; d.Name.Font = 2
    d.Name.Color       = Color3.new(1,1,1); d.Name.ZIndex = 3; d.Name.Visible = false

    d.Distance         = Drawing.new("Text")
    d.Distance.Size    = 12; d.Distance.Center = true
    d.Distance.Outline = true; d.Distance.Font = 2
    d.Distance.Color   = Color3.new(1,1,1); d.Distance.ZIndex = 3; d.Distance.Visible = false
    return d
end

local function hideDrawingSet(d)
    d.Box.Visible = false; d.BoxOutline.Visible = false
    d.HealthBar.Visible = false; d.HealthBarOutline.Visible = false
    d.Name.Visible = false; d.Distance.Visible = false
end

local function removeDrawingSet(d)
    pcall(function() d.Box:Remove() end)
    pcall(function() d.BoxOutline:Remove() end)
    pcall(function() d.HealthBar:Remove() end)
    pcall(function() d.HealthBarOutline:Remove() end)
    pcall(function() d.Name:Remove() end)
    pcall(function() d.Distance:Remove() end)
end

local function updateDrawingESP(model, d, color, showBox, showHealth, showName, showDist)
    -- R6 NPCs dùng Torso, players dùng HumanoidRootPart
    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model.PrimaryPart
    local head = model:FindFirstChild("Head")
    if not root then hideDrawingSet(d); return end

    local rootPos = root.Position
    local camPos  = camera.CFrame.Position
    local dist    = (camPos - rootPos).Magnitude

    local screenRoot, onScreen = camera:WorldToViewportPoint(rootPos)
    if not onScreen then hideDrawingSet(d); return end

    -- box height từ head đến chân
    local heightWorld = head and 5.5 or 4.5
    local topPt    = camera:WorldToViewportPoint(rootPos + Vector3.new(0,  heightWorld * 0.5, 0))
    local bottomPt = camera:WorldToViewportPoint(rootPos - Vector3.new(0,  heightWorld * 0.5, 0))
    local boxH     = math.abs(bottomPt.Y - topPt.Y)
    if boxH < 5 then hideDrawingSet(d); return end  -- quá nhỏ = quá xa, skip
    local boxW     = boxH * 0.55
    local bpX      = screenRoot.X - boxW * 0.5
    local bpY      = screenRoot.Y - boxH * 0.5

    -- box
    if showBox then
        d.BoxOutline.Size     = Vector2.new(boxW, boxH)
        d.BoxOutline.Position = Vector2.new(bpX, bpY)
        d.BoxOutline.Visible  = true
        d.Box.Size            = Vector2.new(boxW, boxH)
        d.Box.Position        = Vector2.new(bpX, bpY)
        d.Box.Color           = color
        d.Box.Visible         = true
    else
        d.Box.Visible = false; d.BoxOutline.Visible = false
    end

    -- health bar — Reign Fall lưu health tại Humanoid.Values.Health (NumberValue)
    -- max health tại Humanoid.Values.Health.Max (NumberValue)
    -- fallback về Humanoid.Health / MaxHealth nếu không tìm thấy custom path
    if showHealth then
        local pct = 1
        local humanoid = model:FindFirstChildWhichIsA("Humanoid")
        local hValues  = humanoid and humanoid:FindFirstChild("Values")
        local healthNV = hValues and hValues:FindFirstChild("Health")
        local maxNV    = healthNV and healthNV:FindFirstChild("Max")
        if healthNV and maxNV and maxNV.Value > 0 then
            pct = math.clamp(healthNV.Value / maxNV.Value, 0, 1)
        elseif humanoid and humanoid.MaxHealth > 0 then
            pct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
        end
        local barH     = boxH * pct
        local barColor = Color3.fromHSV(pct * 0.33, 1, 1)

        d.HealthBarOutline.Size     = Vector2.new(4, boxH + 2)
        d.HealthBarOutline.Position = Vector2.new(bpX - 6, bpY - 1)
        d.HealthBarOutline.Visible  = true
        d.HealthBar.Size            = Vector2.new(2, barH)
        d.HealthBar.Position        = Vector2.new(bpX - 5, bpY + (boxH - barH))
        d.HealthBar.Color           = barColor
        d.HealthBar.Visible         = true
    else
        d.HealthBar.Visible = false; d.HealthBarOutline.Visible = false
    end

    -- name
    if showName then
        local nameStr = model.Name ~= "" and model.Name or "Enemy"
        d.Name.Text     = nameStr
        d.Name.Color    = color
        d.Name.Position = Vector2.new(screenRoot.X, bpY - 16)
        d.Name.Visible  = true
    else d.Name.Visible = false end

    -- distance (studs → metres * 0.28)
    if showDist then
        d.Distance.Text     = string.format("[%dm]", math.floor(dist * 0.28))
        d.Distance.Position = Vector2.new(screenRoot.X, bpY + boxH + 2)
        d.Distance.Visible  = true
    else d.Distance.Visible = false end
end

local function UpdateESP()
    local aliveModels = {}

    -- zombies
    if config.zombieESP then
        local container = getEnemyContainer()
        if container then
            for _, zombie in ipairs(container:GetChildren()) do
                -- dùng FindFirstChild thẳng — NPC Reign Fall dùng "Humanoid" exact name
                -- fallback: nếu có PrimaryPart thì vẫn hiện (dead body có thể mất Humanoid)
                local hasHumanoid = zombie:FindFirstChild("Humanoid") ~= nil
                if zombie:IsA("Model") and (hasHumanoid or zombie.PrimaryPart) then
                    aliveModels[zombie] = "zombie"
                    if not drawingESPPool[zombie] then
                        drawingESPPool[zombie] = createDrawingSet()
                    end
                    updateDrawingESP(zombie, drawingESPPool[zombie],
                        Color3.fromRGB(255, 60, 60),
                        config.zombieBox, config.zombieHealth,
                        config.zombieName, config.zombieDistance)
                end
            end
        end
    end

    -- players
    if config.playerESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") then
                local char = player.Character
                aliveModels[char] = "player"
                if not drawingESPPool[char] then
                    drawingESPPool[char] = createDrawingSet()
                end
                updateDrawingESP(char, drawingESPPool[char],
                    Color3.fromRGB(0, 200, 255),
                    config.playerBox, config.playerHealth,
                    config.playerName, config.playerDistance)
            end
        end
    end

    -- cleanup stale entries (model removed or toggle turned off)
    for model, d in pairs(drawingESPPool) do
        if not aliveModels[model] then
            hideDrawingSet(d)
            removeDrawingSet(d)
            drawingESPPool[model] = nil
        end
    end
end

-- ─── SILENT AIM ───────────────────────────────────────────────────────────────

local function getClosestHead()
    local container = getEnemyContainer()
    if not container then return nil end
    local referencePos
    if isMobile then
        local vp = camera.ViewportSize
        referencePos = Vector2.new(vp.X / 2, vp.Y / 2)
    else
        referencePos = UserInputService:GetMouseLocation()
    end
    local bestHeadPos, bestDist = nil, math.huge
    for _, enemy in ipairs(container:GetChildren()) do
        local head = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart")
        if head then
            local screenPoint, onScreen = camera:WorldToScreenPoint(head.Position)
            if onScreen then
                local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - referencePos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestHeadPos = head.Position
                end
            end
        end
    end
    return bestHeadPos
end

RunService.Heartbeat:Connect(function()
    if config.raycasting and target.enabled then
        target.position = getClosestHead()
    else
        target.position = nil
    end
end)

-- "Raycast" exact-match — no :lower() allocation every call
local RAYCAST_METHOD = "Raycast"

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    -- fast path: anything that isn't Workspace:Raycast exits in one compare
    if self ~= Workspace or getnamecallmethod() ~= RAYCAST_METHOD then
        return oldNamecall(self, ...)
    end

    local origin, dir, params = ...

    -- only touch weapon raycasts — everything else untouched
    if not params or params.CollisionGroup ~= "raycast_npc_neutral" then
        return oldNamecall(self, ...)
    end

    local doSpread = config.noSpread
    local doSilent = config.raycasting and target.position ~= nil

    if not doSpread and not doSilent then
        return oldNamecall(self, ...)
    end

    -- NoSpread: game appends Vector3(rand, rand, rand) to LookVector*1000.
    -- Snap back to camera LookVector * original magnitude — offset gone.
    if doSpread then
        dir = camera.CFrame.LookVector * dir.Magnitude
    end

    -- SilentAim runs after spread strip so both features compose cleanly.
    if doSilent then
        local toTarget = target.position - origin
        if toTarget.Magnitude > 0.001 then
            dir = toTarget.Unit * dir.Magnitude
        end
    end

    return oldNamecall(self, origin, dir, params)
end))

-- ─── AUTO HIT ────────────────────────────────────────────────────────────────

local function findRegisterHitEvent()
    local char = lp.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        local se = child:FindFirstChild("ServerEvents")
        if se then
            local re = se:FindFirstChild("RegisterHit")
            if re and re:IsA("RemoteEvent") then return re end
        end
    end
    return nil
end

local function getTargets()
    local results = {}
    local container = getEnemyContainer()
    if not container then return results end
    for _, npc in ipairs(container:GetChildren()) do
        if npc:IsA("Model") and npc:FindFirstChildWhichIsA("Humanoid") then
            local part = npc:FindFirstChild("Torso") or npc:FindFirstChild("HumanoidRootPart")
            if part then
                table.insert(results, {model = npc, part = part})
            end
        end
    end
    return results
end

task.spawn(function()
    while task.wait(0.2) do
        if config.autoHit then
            local hitEvent = findRegisterHitEvent()
            if hitEvent then
                local targets = getTargets()
                if #targets > 0 then
                    local payload = {}
                    for _, t in ipairs(targets) do
                        table.insert(payload, {amount = 1, target = t.model, is_friendly = false, part = t.part})
                    end
                    hitEvent:FireServer(payload, {})
                end
            end
        end
    end
end)

